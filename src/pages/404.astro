---
import BaseLayout from '@layouts/BaseLayout.astro';
import Terminal from '@components/Terminal.astro';
import Window from '@components/Window.astro';

const notFoundTerminal = ` _  _    ___   _  _
| || |  / _ \\ | || |
| || |_| | | || || |_
|__   _|| |_| ||__   _|
   |_|  \\___/    |_|`;
---

<BaseLayout title="404: not found" description="Page not found" noIndex>
  <div class="desktop">
    <Window title="zsh: no such file or directory" variant="danger">
      <section class="notfound">
        <Terminal body={notFoundTerminal} tone="danger" compact />
        <h1>signal lost</h1>
        <p class="fallen">ironclad has fallen. floor 404.</p>
        <p>the path <code id="missing-path">{Astro.url.pathname}</code> doesn't resolve.</p>
        <p><a href="/" class="btn btn-red">Return home</a></p>
      </section>
    </Window>
  </div>
</BaseLayout>

<style>
  .notfound {
    padding: 1.5rem 0;
    text-align: center;
  }

  h1 {
    color: var(--ctp-red);
    margin: 0 0 0.4rem;
  }

  .fallen {
    color: var(--ctp-maroon);
    margin-bottom: 1.4rem;
  }

  .btn { margin-top: 0.6rem; }
</style>

<script>
  const path = window.location.pathname;
  const code = document.getElementById('missing-path');
  if (code) code.textContent = path;
  const cwd = document.querySelector('.brand .cwd');
  if (cwd) cwd.textContent = `~${path.replace(/\/$/, '')}`;
</script>
