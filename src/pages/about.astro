---
import BaseLayout from '@layouts/BaseLayout.astro';
import Window from '@components/Window.astro';
import { SITE } from '@lib/config';
import { donutFrame } from '@lib/donut';

const facts = [
  { key: 'name', value: 'Marcos Magno Biriba Ribeiro', tone: 'mauve' },
  { key: 'nickname', value: 'Marc', tone: 'mauve' },
  { key: 'born', value: '2005-01-18, São Paulo, Brazil', tone: 'red' },
  { key: 'based', value: 'Switzerland', tone: 'red' },
  { key: 'role', value: 'infra/devops @ cerrion', tone: 'blue' },
  { key: 'contact', value: 'contact@marc-os.com', tone: 'blue' },
];

const width = Math.max(...facts.map((f) => f.key.length + f.value.length + 5)) + 2;
const ruleTop = `┌${'─'.repeat(width)}┐`;
const ruleBottom = `└${'─'.repeat(width)}┘`;

const donut = donutFrame(1, 1);

const swatches = ['surface2', 'red', 'green', 'yellow', 'blue', 'pink', 'teal', 'subtext0'];
---

<BaseLayout title="about" description={`About ${SITE.author}`}>
  <div class="desktop desktop-float">
    <Window title="fastfetch">
      <section class="about measure">
        <h1># about</h1>

        <div class="fastfetch">
          <pre id="donut" class="ff-logo" aria-hidden="true" set:html={donut} />
          <div class="ff-info">
            <p class="ff-host"><span class="ff-icon" aria-hidden="true"></span><span class="ff-sep"> : </span><span class="ff-user">marc</span> @ <span class="ff-os">os</span></p>
            <p class="ff-rule" aria-hidden="true">{ruleTop}</p>
            <dl>
              {facts.map((f) => (
                <div class="ff-row"><dt class={`tone-${f.tone}`}>{f.key}</dt><dd>{f.value}</dd></div>
              ))}
            </dl>
            <p class="ff-rule" aria-hidden="true">{ruleBottom}</p>
            <p class="ff-swatches" aria-hidden="true">
              {swatches.map((c) => <span class={`sw sw-${c}`}>●</span>)}
            </p>
          </div>
        </div>

        <p>
          Hello, my name is Marcos Magno Biriba Ribeiro, though I usually go by Marcos Magno (or Marc).
          My family names reflect my heritage: Ribeiro is my father's surname, and Biriba comes from my
          mother's side. Born on January 18, 2005, in São Paulo, Brazil, I've always been surrounded by
          the energy and diversity of one of the world's largest cities.
        </p>

        <p>
          My interests are as varied as they are passionate. I love playing guitar, engaging in sports,
          and spending quality time with friends, family, and my fiancée. While I cherish moments of
          creativity and activity, I also appreciate calm, relaxed environments over noisy, crowded
          parties. I even humorously remark about disliking sleep, after all, if you reach the age of
          90, you might spend 30 years asleep!
        </p>

        <p>
          My first spark for technology ignited between the ages of 8 and 13. I taught myself to build
          an automatic door in Minecraft using command blocks. By detecting players within a set radius,
          the door would open, and I even customised it to recognise only my in-game name, creating a
          "private" entrance accessible solely to me.
        </p>

        <p>
          Over the years, I've navigated challenges that have significantly shaped who I am today.
          In 2018, I moved from Brazil to Budapest, Hungary, arriving with little knowledge of Hungarian
          and only basic English. Through relentless effort, I transformed my language skills, and now I
          speak English fluently with a touch of Hungarian. Then, in 2020, I embraced yet another
          challenge by moving to Switzerland. Here, I'm diligently working to master German, a language
          essential for both my professional growth and everyday life.
        </p>

        <p>
          My journey into technology began with my apprenticeship on August 2nd 2021, inspired by my
          dad's career, delving into platform development and deepening my understanding of computer
          hardware, network systems, and innovative solutions. After completing it, in 2025 I joined the
          infra/DevOps team at <a href="https://cerrion.com" rel="noopener">Cerrion</a>, a Zurich-based
          AI startup building video AI agents for manufacturing. Cerrion helps production teams detect
          and respond to process, quality, and safety issues in real-time, straight from existing camera
          feeds.
        </p>

        <p>
          I believe perseverance is the key to overcoming any obstacle, whether it's learning a new
          language, adapting to a new country, or diving into complex technical challenges. My journey
          is one of continuous growth and unwavering determination.
        </p>

        <div class="cta">
          <a href="/projects" class="btn">Browse Projects</a>
          <a href={SITE.social.github} rel="noopener" class="btn btn-blue">GitHub</a>
          <a href={SITE.social.linkedin} rel="me noopener" class="btn btn-sapphire">LinkedIn</a>
          <a href="/cv.pdf" class="btn btn-peach">Download CV</a>
        </div>
      </section>
    </Window>
  </div>
</BaseLayout>

<style>
  .about h1 { margin-top: 0; }
  .about p { line-height: 1.75; }

  .fastfetch {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.4rem;
    align-items: center;
    margin: 0 0 2rem;
  }

  .ff-logo {
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent !important;
    font-size: 0.68rem;
    line-height: 1.05;
    font-variant-ligatures: none;
    color: var(--ctp-mauve);
    overflow: visible;
    flex: none;
  }

  .ff-logo :global(.d0) { color: color-mix(in oklab, var(--ctp-mauve) 28%, var(--ctp-base)); }
  .ff-logo :global(.d1) { color: color-mix(in oklab, var(--ctp-mauve) 36%, var(--ctp-base)); }
  .ff-logo :global(.d2) { color: color-mix(in oklab, var(--ctp-mauve) 44%, var(--ctp-base)); }
  .ff-logo :global(.d3) { color: color-mix(in oklab, var(--ctp-mauve) 52%, var(--ctp-base)); }
  .ff-logo :global(.d4) { color: color-mix(in oklab, var(--ctp-mauve) 60%, var(--ctp-base)); }
  .ff-logo :global(.d5) { color: color-mix(in oklab, var(--ctp-mauve) 68%, var(--ctp-base)); }
  .ff-logo :global(.d6) { color: color-mix(in oklab, var(--ctp-mauve) 77%, var(--ctp-base)); }
  .ff-logo :global(.d7) { color: color-mix(in oklab, var(--ctp-mauve) 88%, var(--ctp-base)); }
  .ff-logo :global(.d8) { color: var(--ctp-mauve); }
  .ff-logo :global(.d9) { color: color-mix(in oklab, var(--ctp-mauve) 70%, var(--ctp-lavender)); }
  .ff-logo :global(.d10) { color: color-mix(in oklab, var(--ctp-mauve) 40%, var(--ctp-lavender)); }
  .ff-logo :global(.d11) { color: var(--ctp-lavender); }

  .ff-info { font-size: 0.88rem; min-width: 0; }
  .ff-info p { margin: 0; line-height: 1.6; }
  .ff-icon { color: var(--ctp-blue); font-family: 'marc-icons', var(--font-mono); }
  .ff-sep { color: var(--text); white-space: pre; }
  .ff-user, .ff-os { color: var(--ctp-mauve); }
  .ff-rule {
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    font-variant-ligatures: none;
  }

  dl { margin: 0; }
  .ff-row { display: flex; padding-left: 2ch; }
  dt::after { content: ' : '; color: var(--text); white-space: pre; }
  dd { margin: 0; color: var(--text); }
  .tone-mauve { color: var(--ctp-mauve); }
  .tone-red { color: var(--ctp-red); }
  .tone-blue { color: var(--ctp-blue); }

  .ff-swatches {
    margin-top: 0.5rem !important;
    padding-left: 2ch;
  }
  .sw { margin-right: 0.35em; font-size: 1.15em; }
  .sw-surface2 { color: var(--ctp-surface2); }
  .sw-red { color: var(--ctp-red); }
  .sw-green { color: var(--ctp-green); }
  .sw-yellow { color: var(--ctp-yellow); }
  .sw-blue { color: var(--ctp-blue); }
  .sw-pink { color: var(--ctp-pink); }
  .sw-teal { color: var(--ctp-teal); }
  .sw-subtext0 { color: var(--ctp-subtext0); }

  .cta { margin-top: 2rem; }

  @media (max-width: 560px) {
    .fastfetch { grid-template-columns: minmax(0, 1fr); }
    .ff-row { flex-wrap: wrap; }
  }
</style>

<script>
  import { donutFrame } from '@lib/donut';

  const el = document.getElementById('donut');
  if (el && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let A = 1;
    let B = 1;
    let raf = 0;
    let last = 0;
    let visible = true;
    const FRAME_MS = 1000 / 24;

    const tick = (now: number) => {
      raf = requestAnimationFrame(tick);
      if (now - last < FRAME_MS) return;
      last = now;
      A += 0.07;
      B += 0.03;
      el.innerHTML = donutFrame(A, B);
    };

    const start = () => {
      if (!raf && visible && !document.hidden) raf = requestAnimationFrame(tick);
    };
    const stop = () => {
      cancelAnimationFrame(raf);
      raf = 0;
    };

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      visible ? start() : stop();
    }).observe(el);

    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
  }
</script>
