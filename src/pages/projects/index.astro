---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProjectCard from '@components/ProjectCard.astro';
import Window from '@components/Window.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return (
    b.data.pubDate.valueOf() - a.data.pubDate.valueOf() ||
    a.data.title.localeCompare(b.data.title)
  );
});
---

<BaseLayout title="projects" description="Things I've built, broken, and occasionally finished.">
  <div class="desktop">
    <Window title="ls ~/projects">
      <section class="projects-index">
        <header class="page-header">
          <h1>projects</h1>
          <p class="dim">things I've built: open source, infra experiments, homelab tools.</p>
        </header>

        <div class="grid">
          {projects.map((p) => (
            <ProjectCard
              title={p.data.title}
              description={p.data.description}
              href={`/projects/${p.id}`}
              repo={p.data.repo}
              url={p.data.url}
              status={p.data.status}
              tags={p.data.tags}
            />
          ))}
        </div>

        {projects.length === 0 && (
          <div class="empty">
            <p>no projects yet. drop a markdown file in <code>src/content/projects/</code>.</p>
          </div>
        )}
      </section>
    </Window>
  </div>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px dashed var(--border);
  }
  .page-header h1 {
    margin: 0;
    font-size: 1.7rem;
  }
  .page-header h1::before {
    content: '# ';
    color: var(--accent);
  }
  .dim {
    color: var(--text-dim);
    font-size: 0.85rem;
    margin: 0.4rem 0 0;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.4rem 2.5rem;
  }
  @media (min-width: 720px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .grid > :global(.proj:nth-child(2)::before) { display: none !important; }
  }
  @media (min-width: 1400px) {
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .grid > :global(.proj:nth-child(3)::before) { display: none !important; }
  }

  .empty {
    border: 1px dashed var(--border);
    border-radius: var(--radius-sm);
    padding: 2rem;
    text-align: center;
    color: var(--text-muted);
  }
</style>
