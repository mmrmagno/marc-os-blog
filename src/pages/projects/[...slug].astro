---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Tag from '@components/Tag.astro';
import FormattedDate from '@components/FormattedDate.astro';
import Window from '@components/Window.astro';
import Status from '@components/Status.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((p) => ({
    params: { slug: p.id },
    props: p,
  }));
}

type Props = CollectionEntry<'projects'>;
const project = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.description}>
  <div class="desktop desktop-float">
    <Window title={`cat ~/projects/${project.id}/${project.id}.md`}>
      <article class="project measure">
        <header class="proj-header">
          <a href="/projects" class="back-link">← back to /projects</a>
          <h1>{project.data.title}</h1>
          <div class="meta">
            <FormattedDate date={project.data.pubDate} />
            <span class="sep">·</span>
            <Status status={project.data.status} />
          </div>
          {project.data.tags.length > 0 && (
            <div class="tags">{project.data.tags.map((t) => <Tag tag={t} />)}</div>
          )}
          <div class="links">
            {project.data.repo && <a href={project.data.repo} rel="noopener" class="ext">source →</a>}
            {project.data.url && <a href={project.data.url} rel="noopener" class="ext">live →</a>}
          </div>
        </header>
        <div class="prose">
          <Content />
        </div>
      </article>
    </Window>
  </div>
</BaseLayout>

<style>
  .proj-header {
    margin-bottom: 2rem;
    padding-bottom: 1.4rem;
    border-bottom: 1px dashed var(--border);
  }
  .proj-header h1 {
    margin: 0.6em 0 0.3em;
    font-size: 2rem;
  }
  .proj-header h1::before {
    content: '> ';
    color: var(--accent);
  }
  .meta {
    color: var(--text-dim);
    font-size: 0.82rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }
  .sep { color: var(--ctp-overlay1); }
  .tags { margin-top: 0.85rem; display: flex; gap: 0.2rem 0.8rem; flex-wrap: wrap; }
  .links { margin-top: 1rem; display: flex; gap: 1.2rem; font-size: 0.88rem; }
  .ext { color: var(--ctp-blue); border: 0; }
  .ext:hover { color: var(--ctp-lavender); }
</style>
