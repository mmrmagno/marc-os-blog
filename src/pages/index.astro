---
import BaseLayout from '@layouts/BaseLayout.astro';
import PostCard from '@components/PostCard.astro';
import ProjectCard from '@components/ProjectCard.astro';
import Terminal from '@components/Terminal.astro';
import Window from '@components/Window.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const featured = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.data.title.localeCompare(b.data.title);
  })
  .slice(0, 5);

const heroTerminal = `$ whoami
infra · devops · homelab

$ uptime
building things, breaking things, fixing
them again. occasionally writing it down.`;
---

<BaseLayout>
  <div class="desktop tiles">
    <Window title="zsh ~" class="tile-main">
      <section class="hero">
        <Terminal body={heroTerminal} />

        <p class="lede">
          <span class="prompt">$</span> Welcome. I write about <span class="hl">infrastructure</span>, <span class="hl">devops</span>, and the occasional 2am <span class="hl">debugging story</span>.
        </p>

        <div class="cta">
          <a href="/blog" class="btn">Read The blog</a>
          <a href="/projects" class="btn btn-blue">Browse Projects</a>
          <a href="/about" class="btn btn-lavender">About Me</a>
          <a href="/cv.pdf" class="btn btn-peach">Download CV</a>
        </div>

        <p class="idle" aria-hidden="true"><span class="prompt">marc@os</span><span class="dim">:</span><span class="cwd">~</span><span class="dim">$</span> <span class="cursor">▊</span></p>
      </section>
    </Window>

    {posts.length > 0 && (
      <Window title="ls ~/blog" class="tile-side1">
        <h2 class="sr-only">Recent posts</h2>
        <div class="list">
          {posts.map((p) => (
            <PostCard
              href={`/blog/${p.id}`}
              title={p.data.title}
              description={p.data.description}
              pubDate={p.data.pubDate}
              tags={p.data.tags}
            />
          ))}
        </div>
        <p class="see-all"><a href="/blog">See All Posts →</a></p>
      </Window>
    )}

    {featured.length > 0 && (
      <Window title="ls ~/projects" class="tile-side2">
        <h2 class="sr-only">Featured projects</h2>
        <div class="list">
          {featured.map((p) => (
            <ProjectCard
              title={p.data.title}
              description={p.data.description}
              href={`/projects/${p.id}`}
              repo={p.data.repo}
              url={p.data.url}
              status={p.data.status}
              tags={p.data.tags}
            />
          ))}
        </div>
        <p class="see-all"><a href="/projects">All Projects →</a></p>
      </Window>
    )}
  </div>
</BaseLayout>

<style>
  .lede {
    font-size: 1rem;
    color: var(--text-muted);
    margin: 0 0 1.4rem;
    line-height: 1.7;
  }

  .prompt { color: var(--prompt); margin-right: 0.4em; }
  .hl { color: var(--ctp-mauve); }

  .idle {
    margin: 2rem 0 0;
    font-size: 0.9rem;
  }
  .idle .prompt { margin-right: 0; }
  .idle .dim { color: var(--ctp-overlay1); }
  .idle .cwd { color: var(--ctp-blue); }
  .idle .cursor {
    color: var(--prompt);
    animation: blink 1.1s steps(2) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .see-all {
    margin: 0.8rem 0 0;
    font-size: 0.85rem;
  }
  .see-all a { color: var(--ctp-blue); border: 0; }
  .see-all a:hover { color: var(--ctp-lavender); }
</style>
