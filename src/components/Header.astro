---
import { SITE } from '@lib/config';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  path === href || (href !== '/' && path.startsWith(href));
---

<header class="bar">
  <div class="bar-inner">
    <nav class="pill workspaces" aria-label="Primary">
      <ul>
        {SITE.nav.map((item, i) => (
          <li>
            <a
              href={item.href}
              data-ws={i + 1}
              class:list={[{ active: isActive(item.href) }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              <span class="ws-num">{i + 1}</span>
              <span class="ws-label">{item.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a href="/" class="pill brand" aria-label="Home">
      <span class="prompt">marc@os</span><span class="sep">:</span><span class="cwd">~{path === '/' ? '' : path.replace(/\/$/, '')}</span><span class="cursor" aria-hidden="true">▊</span>
    </a>

    <div class="bar-right">
      <span class="pill spire" title="architect and ironclad up, two MS-01s not named yet">spire 2/4</span>
      <span class="pill clock" title="Marc's local time, Europe/Zurich">
        <time id="bar-clock">--:--</time> <span class="tz">zrh</span>
      </span>
    </div>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 10;
    padding: var(--gap-out) var(--gap-out) 0;
  }

  .bar-inner {
    max-width: calc(var(--max-w-desktop) - 2 * var(--gap-out));
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-in);
    padding: 4px;
    border-radius: var(--radius);
    background: var(--bar-bg);
    -webkit-backdrop-filter: blur(var(--blur));
    backdrop-filter: blur(var(--blur));
    font-size: 0.85rem;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.25em 0.8em;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--ctp-surface0) 70%, transparent);
    color: var(--text-muted);
    white-space: nowrap;
  }

  .workspaces { padding: 2px; }

  .workspaces ul {
    list-style: none;
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0;
  }

  .workspaces a {
    display: inline-flex;
    gap: 0.45em;
    padding: 0.2em 0.7em;
    border: 0;
    border-radius: 5px;
    color: var(--text-muted);
    transition: background 120ms ease, color 120ms ease;
  }

  .workspaces a:hover {
    color: var(--ctp-crust);
    background: var(--ctp-mauve);
  }

  .workspaces a.active {
    color: var(--ctp-crust);
    background: var(--ws-active);
  }

  .ws-num { color: var(--ctp-overlay1); }
  .workspaces a:hover .ws-num,
  .workspaces a.active .ws-num { color: var(--ctp-surface1); }

  .brand {
    display: block;
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    border: 0;
    font-size: 0.9rem;
  }
  .brand:hover { color: var(--text-muted); }
  .brand .prompt { color: var(--prompt); }
  .brand .sep { color: var(--ctp-overlay1); }
  .brand .cwd { color: var(--ctp-blue); }
  .brand .cursor {
    color: var(--prompt);
    animation: blink 1.1s steps(2) infinite;
    margin-left: 2px;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .bar-right {
    display: flex;
    flex: none;
    gap: var(--gap-in);
  }

  .workspaces { flex: none; }

  .spire { color: var(--ctp-teal); }
  .clock { color: var(--ctp-text); font-variant-numeric: tabular-nums; }
  .tz { color: var(--text-dim); }

  @media (max-width: 720px) {
    .bar-inner { flex-wrap: wrap; }
    .brand { order: -1; flex: 1; }
    .workspaces { order: 1; flex-basis: 100%; }
    .workspaces ul { justify-content: space-between; }
    .workspaces li { flex: 1; }
    .workspaces a { width: 100%; justify-content: center; }
  }

  @media (max-width: 480px) {
    .bar-right { display: none; }
    .ws-num { display: none; }
  }
</style>

<script>
  const clock = document.getElementById('bar-clock');
  if (clock) {
    const fmt = new Intl.DateTimeFormat('en-GB', {
      hour: '2-digit',
      minute: '2-digit',
      timeZone: 'Europe/Zurich',
    });
    const tick = () => {
      clock.textContent = fmt.format(new Date());
    };
    tick();
    window.setInterval(tick, 30_000);
  }

  document.addEventListener('keydown', (e) => {
    if (e.ctrlKey || e.metaKey || e.altKey || e.shiftKey) return;
    if (!/^[1-4]$/.test(e.key)) return;
    const t = e.target as HTMLElement | null;
    if (t && (t.isContentEditable || /input|textarea|select/i.test(t.tagName))) return;
    const link = document.querySelector<HTMLAnchorElement>(`.workspaces a[data-ws="${e.key}"]`);
    if (!link || link.classList.contains('active')) return;
    window.location.href = link.href;
  });
</script>
