---
interface Props {
  body: string;
  tone?: 'accent' | 'danger';
  compact?: boolean;
  ariaHidden?: boolean;
  class?: string;
}

const {
  body,
  tone = 'accent',
  compact = false,
  ariaHidden = true,
  class: className = '',
} = Astro.props;

const classes = [
  'terminal',
  tone === 'danger' && 'terminal-danger',
  compact && 'terminal-compact',
  className,
].filter(Boolean);
---

<pre class:list={classes} aria-hidden={ariaHidden ? 'true' : undefined}>{body}</pre>

<style>
  .terminal {
    --terminal-accent: var(--prompt);

    display: block;
    margin: 0 0 1.4rem;
    padding: 0;
    background: transparent !important;
    border: 0;
    color: var(--terminal-accent);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.65;
    text-align: left;
    text-shadow: 0 0 10px color-mix(in srgb, var(--terminal-accent) 30%, transparent);
    overflow-x: auto;
  }

  .terminal-danger {
    --terminal-accent: var(--ctp-red);
  }

  .terminal-compact {
    display: inline-block;
  }
</style>
