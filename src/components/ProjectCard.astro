---
import Tag from './Tag.astro';
import Status from './Status.astro';

interface Props {
  title: string;
  description: string;
  href: string;
  repo?: string;
  url?: string;
  status?: 'active' | 'maintained' | 'archived' | 'wip';
  tags?: string[];
}

const { title, description, href, repo, url, status = 'active', tags = [] } = Astro.props;
---

<article class="proj">
  <header class="proj-head">
    <h3><a href={href}>{title}</a></h3>
    <Status status={status} />
  </header>
  <p class="desc">{description}</p>
  {(tags.length > 0 || repo || url) && (
    <div class="foot">
      {tags.map((t) => <Tag tag={t} />)}
      {repo && <a href={repo} rel="noopener" class="ext-link">source →</a>}
      {url && <a href={url} rel="noopener" class="ext-link">live →</a>}
    </div>
  )}
</article>

<style>
  .proj {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.7rem 0.75rem;
    margin: 0 -0.75rem;
    border-radius: var(--radius-sm);
    position: relative;
    transition: background 120ms ease;
  }

  .proj + .proj::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0.75rem;
    right: 0.75rem;
    border-top: 1px dashed var(--ctp-surface1);
  }

  .proj:hover,
  .proj:focus-within {
    background: color-mix(in srgb, var(--ctp-surface0) 55%, transparent);
  }

  .proj-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .proj h3 { margin: 0; font-size: 1rem; }
  .proj h3::before {
    content: '> ';
    color: var(--prompt);
  }
  .proj h3 a { color: var(--text); border: 0; }
  .proj h3 a:hover { color: var(--accent); }

  .desc { margin: 0; color: var(--text-muted); font-size: 0.88rem; }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.8rem;
    font-size: 0.8rem;
  }

  .ext-link {
    color: var(--ctp-blue);
    border: 0;
  }
  .ext-link:hover { color: var(--ctp-lavender); }
</style>
