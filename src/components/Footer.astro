---
import { SITE, SPLASHES } from '@lib/config';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <span class="dim">{year} · {SITE.author}</span>
    <span class="splash">
      <span class="cmd">$ hyprctl splash</span>
      <span id="splash-line" data-splashes={JSON.stringify(SPLASHES)}>{SPLASHES[0]}</span>
    </span>
    <span class="links">
      <a href={SITE.social.github} rel="me noopener" class="footer-link">GitHub</a>
      <span class="dim">·</span>
      <a href={SITE.social.linkedin} rel="me noopener" class="footer-link">LinkedIn</a>
      <span class="dim">·</span>
      <a href={SITE.social.email} class="footer-link">Email</a>
      <span class="dim">·</span>
      <a href="/rss.xml" class="footer-link">RSS</a>
    </span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 2rem;
    padding: 0 var(--gap-out) var(--gap-out);
  }

  .footer-inner {
    max-width: calc(var(--max-w-desktop) - 2 * var(--gap-out));
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1.2rem;
    padding: 0.55rem 0.9rem;
    border-radius: var(--radius);
    background: var(--bar-bg);
    -webkit-backdrop-filter: blur(var(--blur));
    backdrop-filter: blur(var(--blur));
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .dim { color: var(--text-dim); }

  .splash { display: inline-flex; gap: 0.6em; flex-wrap: wrap; }
  .splash .cmd { color: var(--ctp-overlay0); }
  #splash-line { color: var(--ctp-lavender); }

  .links { display: inline-flex; gap: 0.55rem; }

  .footer-link {
    color: var(--text-muted);
    border: 0;
  }
  .footer-link:hover { color: var(--accent); }
</style>

<script>
  const line = document.getElementById('splash-line');
  if (line?.dataset.splashes) {
    const all = JSON.parse(line.dataset.splashes) as string[];
    line.textContent = all[Math.floor(Math.random() * all.length)];
  }
</script>
