---
interface Props {
  tag: string;
  href?: string;
}
const { tag, href } = Astro.props;
const target = href ?? `/blog/tags/${tag.toLowerCase()}`;
---

<a class="tag" href={target}>
  <span class="hash">#</span>{tag}
</a>

<style>
  .tag {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ctp-teal);
    border-bottom: 1px dashed transparent;
  }

  .tag:hover,
  .tag:focus-visible {
    color: var(--ctp-teal);
    border-bottom-color: var(--ctp-teal);
  }

  .hash { color: var(--ctp-overlay1); }
</style>
