---
import FormattedDate from './FormattedDate.astro';
import Tag from './Tag.astro';

interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
}

const { href, title, description, pubDate, tags = [] } = Astro.props;
---

<article class="row">
  <FormattedDate date={pubDate} class="row-date" />
  <div class="row-main">
    <a href={href} class="row-link">
      <h2>{title}</h2>
      <p class="desc">{description}</p>
    </a>
    {tags.length > 0 && (
      <div class="tags">
        {tags.map((t) => <Tag tag={t} />)}
      </div>
    )}
  </div>
</article>

<style>
  .row {
    display: grid;
    grid-template-columns: 7.5em minmax(0, 1fr);
    gap: 0.2rem 1rem;
    padding: 0.7rem 0.75rem;
    margin: 0 -0.75rem;
    border-radius: var(--radius-sm);
    position: relative;
    transition: background 120ms ease;
  }

  .row + .row::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0.75rem;
    right: 0.75rem;
    border-top: 1px dashed var(--ctp-surface1);
  }

  .row:hover,
  .row:focus-within {
    background: color-mix(in srgb, var(--ctp-surface0) 55%, transparent);
  }

  .row :global(.row-date) { padding-top: 0.15em; }

  .row-link {
    display: block;
    color: inherit;
    border: 0;
  }
  .row-link:hover { color: inherit; }

  .row h2 {
    margin: 0 0 0.25rem;
    font-size: 1rem;
    color: var(--text);
    transition: color 120ms ease;
  }
  .row h2::before {
    content: '$ ';
    color: var(--prompt);
  }
  .row-link:hover h2,
  .row-link:focus-visible h2 { color: var(--accent); }

  .desc {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.88rem;
  }

  .tags {
    margin-top: 0.4rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.8rem;
  }

  @media (max-width: 560px) {
    .row { grid-template-columns: minmax(0, 1fr); }
  }
</style>
