{
  "id": "marc-os-blog",
  "execute-command": "/home/mmr/marc-os-blog/scripts/deploy.sh",
  "command-working-directory": "/home/mmr/marc-os-blog",
  "include-command-output-in-response": true,
  "include-command-output-in-response-on-error": true,
  "incoming-payload-content-type": "application/json",
  "trigger-rule-mismatch-http-response-code": 403,
  "trigger-rule": {
    "match": {
      "type": "payload-hmac-sha256",
      "secret": "REPLACE_WITH_THE_SAME_VALUE_AS_THE_DEPLOY_WEBHOOK_SECRET_REPO_SECRET",
      "parameter": { "source": "header", "name": "X-Hub-Signature-256" }
    }
  }
}
